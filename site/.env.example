# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).

# --- Prévia: "true" esconde o site do Google (usar até o lançamento oficial) ---
NOINDEX=

# --- Painel do blog (Sanity) — ver README, seção "Painel do blog" ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Segredo do webhook (qualquer texto longo e aleatório; o mesmo cadastrado no webhook da Sanity)
SANITY_REVALIDATE_SECRET=
# Só para o script de importação (scripts/import-posts.ts). NÃO cadastrar na Vercel.
SANITY_API_WRITE_TOKEN=

# --- Formulário de contato (Resend) ---
RESEND_API_KEY=
CONTACT_FROM="Site Planecon <site@planeconcontabilidade.com.br>"
CONTACT_TO=jmmonegatte@planeconcontabilidade.com.br

# --- Atualize-se: notícias automáticas ---
# As fontes públicas (Contábeis, Agência Brasil) já vêm configuradas em src/content/newsSources.ts
# e NÃO precisam de nada aqui. As variáveis abaixo são opcionais.

# Opcional — API JSON paga (ex.: TBrWeb). Se preenchida, substitui os feeds RSS.
NEWS_API_URL=
NEWS_API_KEY=
# Nome do cabeçalho que leva a chave (padrão da TBrWeb: x-sgc-header)
NEWS_API_HEADER=x-sgc-header
# Caminhos da API ({page}, {perPage} e {id} são substituídos automaticamente)
NEWS_LIST_PATH=/information/news?page={page}&per_page={perPage}
NEWS_ITEM_PATH=/information/news/{id}

# Opcional — um feed RSS extra (somado às fontes de newsSources.ts)
NEWS_RSS_URL=
